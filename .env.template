# 本地参考模板：GitHub Actions 跑的时候不需要这个文件，
# 工作流会用 tools/write_env.py 自动生成 app/.env（密钥来自 Secrets）。
# 如果你要在自己电脑上手动跑一次，可以复制成 .env 并填好 OPENAI_API_KEY。

OPENAI_API_KEY=（在这里填你的 key，不要提交到仓库）
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL_NAME=deepseek-flash

RUN_HEADLESS=true
RUNNING_IN_DOCKER=true
LOGIN_IS_EDGE=false
PCURL_TO_MOBILE=true

# DeepSeek 的 deepseek-flash 自带视觉理解，所以下面这项保持不用改；
# 如果实测报图片相关错误，把 config.json 里每个任务的 analyze_images 改成 false，只按文字判定。
ENABLE_THINKING=false
ENABLE_RESPONSE_FORMAT=true
AI_DEBUG_MODE=false

# 通知渠道：任选其一即可
BARK_URL=
WX_BOT_URL=
PUSHPLUS_TOKEN=
WEBHOOK_URL=

TASK_FAILURE_THRESHOLD=3
TASK_FAILURE_PAUSE_SECONDS=86400
